FROM debian:trixie-20261027-slim

ENV USERNAME=container-user \
    HOME_DIR=/home/container-user \
    LOCAL_BIN=/usr/local/bin \
    DEBIAN_FRONTEND=noninteractive \
    PATH="/home/container-user/.local/bin:/${LOCAL_BIN}:$PATH"

ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid $USER_GID $USERNAME && \
    useradd --uid $USER_UID --gid $USER_GID --create-home --shell /bin/zsh $USERNAME && \
    echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    stow \
    sudo \
    git \
    && rm -rf /var/lib/apt/lists/*

# NVM (Node Version Manager). The Node version itself is chosen in
# scripts/set-node-version.sh (called from post-create.sh, NODE_VERSION in .env).
ENV NVM_DIR="${LOCAL_BIN}/.nvm"
ENV PATH="$NVM_DIR/current:$PATH"
RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | PROFILE="$HOME_DIR/.zshrc" bash

